# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Telegram mode:
# - polling (default, local/dev)
# - webhook (production)
TELEGRAM_MODE=polling

# Webhook settings (required for TELEGRAM_MODE=webhook)
# PUBLIC_BASE_URL must be HTTPS and publicly reachable by Telegram.
PUBLIC_BASE_URL=https://subwatch.example.com
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Optional: Telegram will send header X-Telegram-Bot-Api-Secret-Token on webhook requests.
TELEGRAM_SECRET_TOKEN=your_random_secret_here

# App
PORT=3000

# Postgres
POSTGRES_DB=subwatch
POSTGRES_USER=subwatch
POSTGRES_PASSWORD=subwatch
DATABASE_URL=postgresql://subwatch:subwatch@postgres:5432/subwatch?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Reminders polling interval (ms)
REMINDER_POLL_INTERVAL_MS=60000

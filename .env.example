# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# App
PORT=3000

# Postgres
POSTGRES_DB=subwatch
POSTGRES_USER=subwatch
POSTGRES_PASSWORD=subwatch
DATABASE_URL=postgresql://subwatch:subwatch@postgres:5432/subwatch?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Reminders polling interval (ms)
REMINDER_POLL_INTERVAL_MS=60000
